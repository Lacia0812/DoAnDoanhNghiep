# ASP.NET Core đọc các giá trị này dưới dạng biến môi trường của hệ điều hành/IIS.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://localhost:5000
ConnectionStrings__DefaultConnection=Server=localhost;Database=GiaPhuWaterDeliveryDb;Trusted_Connection=True;TrustServerCertificate=True
Jwt__Key=CHANGE_TO_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
Jwt__Issuer=GiaPhuWaterDelivery
Jwt__Audience=GiaPhuWaterDeliveryClient
Cors__AllowedOrigins__0=https://water.example.com
